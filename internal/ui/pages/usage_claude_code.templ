package pages

import (
	"fmt"
	"strconv"
	"time"
)

// ClaudeCodeTabData holds data for the Claude Code usage tab.
type ClaudeCodeTabData struct {
	UsagePageData
	Cards    []ClaudeCodeTokenCard
	Strategy string // "round_robin" or "lowest_utilization"
}

func (ClaudeCodeTabData) usageTab() {}

// ClaudeCodeTokenCard holds per-token usage data for display.
// Usage fields are *float64: nil = unknown/missing.
type ClaudeCodeTokenCard struct {
	TokenKey  string    `json:"token_key"`
	OrgID     string    `json:"org_id"`
	Error     string    `json:"error"`
	FetchedAt time.Time `json:"fetched_at"`

	SessionUsage   *float64 `json:"session_usage"`
	SessionResetAt string   `json:"session_reset_at"`
	WeeklyUsage    *float64 `json:"weekly_usage"`
	WeeklyResetAt  string   `json:"weekly_reset_at"`
	SonnetUsage    *float64 `json:"sonnet_usage"`
	SonnetResetAt  string   `json:"sonnet_reset_at"`

	OverageStatus         string `json:"overage_status"`
	OverageDisabledReason string `json:"overage_disabled_reason"`

	Disabled bool `json:"disabled"`

	CompositeScore *float64 `json:"composite_score"`
}

// --- Helper functions ---

func ccFmtPct(v *float64) string {
	if v == nil {
		return "—"
	}
	return fmt.Sprintf("%.0f%%", *v*100)
}

func ccBarWidth(v *float64) string {
	if v == nil {
		return "0%"
	}
	return fmt.Sprintf("%.1f%%", min(*v, 1)*100)
}

// ccBarColorStyle returns an inline background-color style for the progress bar.
// Inline styles avoid Tailwind purge issues with dynamically generated class names.
func ccBarColorStyle(v *float64) string {
	if v == nil {
		return ""
	}
	switch {
	case *v < 0.6:
		return "background-color:#0ea5e9" // sky-500
	case *v < 0.8:
		return "background-color:#f59e0b" // amber-500
	default:
		return "background-color:#ef4444" // red-500 (destructive)
	}
}

func ccParseResetTime(raw string) (time.Time, bool) {
	if t, err := time.Parse(time.RFC3339, raw); err == nil {
		return t, true
	}
	if ts, err := strconv.ParseInt(raw, 10, 64); err == nil {
		return time.Unix(ts, 0), true
	}
	return time.Time{}, false
}

func ccResetCountdown(raw string) string {
	if raw == "" {
		return ""
	}
	t, ok := ccParseResetTime(raw)
	if !ok {
		return raw
	}
	d := time.Until(t)
	if d <= 0 {
		return "Reset now"
	}
	hours := int(d.Hours())
	mins := int(d.Minutes()) % 60
	if hours >= 24 {
		return fmt.Sprintf("Resets in %dd %dh %dm", hours/24, hours%24, mins)
	}
	if hours > 0 {
		return fmt.Sprintf("Resets in %dh %dm", hours, mins)
	}
	return fmt.Sprintf("Resets in %dm", mins)
}

func ccCardTitle(card ClaudeCodeTokenCard) string {
	if card.OrgID != "" {
		return card.OrgID
	}
	return card.TokenKey
}

func ccStrategyLabel(s string) string {
	switch s {
	case "lowest_utilization":
		return "Lowest Utilization"
	case "round_robin":
		return "Round Robin"
	default:
		return s
	}
}

// --- Templates ---

templ UsageClaudeCodeTab(data ClaudeCodeTabData) {
	<div id="claude-code-tab-content" class="space-y-4">
		<h3 class="text-sm font-semibold">
			Claude Code — Plan Usage Limits
			if data.Strategy != "" {
				<span class="font-normal text-muted-foreground"> · { ccStrategyLabel(data.Strategy) }</span>
			}
		</h3>
		if len(data.Cards) == 0 {
			<div class="text-sm text-muted-foreground py-4">
				No Anthropic OAuth tokens configured. Add OAuth tokens to your proxy config to see usage data.
			</div>
		} else {
			for _, card := range data.Cards {
				@claudeCodeCard(card)
			}
		}
	</div>
}

templ claudeCodeCard(card ClaudeCodeTokenCard) {
	<div class="rounded-lg border bg-card text-card-foreground shadow-xs p-5 space-y-4">
		<!-- Card Header -->
		<div class="flex items-center justify-between gap-2">
			<div class="flex items-center gap-2">
				<span class="font-mono text-xs text-muted-foreground truncate max-w-[300px]">
					{ ccCardTitle(card) }
				</span>
				if card.OrgID != "" {
					<span class="text-xs text-muted-foreground">
						({ card.TokenKey })
					</span>
				}
			</div>
			<div class="flex items-center gap-2">
				if card.Error != "" {
					<span class="rounded-full px-2 py-0.5 text-xs font-medium bg-destructive/10 text-destructive">
						{ card.Error }
					</span>
				} else if card.OverageStatus != "" {
					<span class={ "rounded-full px-2 py-0.5 text-xs font-medium", ccOverageClass(card.OverageStatus) }>
						{ card.OverageStatus }
					</span>
				}
				if card.Disabled {
					<span class="rounded-full px-2 py-0.5 text-xs font-medium bg-destructive/10 text-destructive">disabled</span>
					<form hx-post="/ui/oauth-tokens/enable" hx-target="#claude-code-tab-content" hx-swap="outerHTML">
						<input type="hidden" name="token_key" value={ card.TokenKey }/>
						<button type="submit" class="rounded px-2 py-0.5 text-xs border hover:bg-muted cursor-pointer">Enable</button>
					</form>
				} else {
					<form hx-post="/ui/oauth-tokens/disable" hx-target="#claude-code-tab-content" hx-swap="outerHTML">
						<input type="hidden" name="token_key" value={ card.TokenKey }/>
						<button type="submit" class="rounded px-2 py-0.5 text-xs border text-muted-foreground hover:bg-muted cursor-pointer">Disable</button>
					</form>
				}
			</div>
		</div>
		if card.SessionUsage == nil && card.WeeklyUsage == nil {
			<div class="text-sm text-muted-foreground">
				No data yet — send a request through this token to populate usage data.
			</div>
		} else {
			<!-- Plan usage limits section -->
			<div class="space-y-3">
				<div class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Plan usage limits</div>
				<!-- Current session (5h) -->
				@ccProgressBar("Current session", card.SessionUsage, card.SessionResetAt)
				<!-- Weekly — All models (7d) -->
				<div class="pt-2 border-t border-border">
					<div class="text-xs font-medium text-muted-foreground mb-2">Weekly limits</div>
					@ccProgressBar("All models", card.WeeklyUsage, card.WeeklyResetAt)
					<!-- Sonnet only (7d_sonnet) -->
					@ccProgressBar("Sonnet only", card.SonnetUsage, card.SonnetResetAt)
				</div>
			</div>
			<!-- Overage -->
			if card.OverageDisabledReason != "" {
				<div class="flex items-center gap-1.5 text-xs">
					<span class="text-muted-foreground">Overage:</span>
					<span class={ "rounded-full px-2 py-0.5 font-medium", ccOverageBadgeClass(card.OverageDisabledReason) }>
						{ ccOverageBadgeLabel(card.OverageDisabledReason) }
					</span>
				</div>
			}
		}
		<div class="flex items-center justify-between text-xs text-muted-foreground pt-1">
			if !card.FetchedAt.IsZero() {
				<span>Last updated: { ccTimeAgo(card.FetchedAt) }</span>
			} else {
				<span>Last updated: never</span>
			}
			if card.CompositeScore != nil {
				<span>Selection score: <span style={ ccCompositeScoreStyle(card.CompositeScore) }>{ fmt.Sprintf("%.2f", *card.CompositeScore) }</span></span>
			}
		</div>
	</div>
}

templ ccProgressBar(label string, usage *float64, resetAt string) {
	<div>
		<div class="flex items-center justify-between mb-1">
			<div class="flex items-center gap-2">
				<span class="text-xs text-muted-foreground">{ label }</span>
				if resetAt != "" {
					<span class="text-xs text-muted-foreground/60">{ ccResetCountdown(resetAt) }</span>
				}
			</div>
			<span class="text-xs font-medium">{ ccFmtPct(usage) } used</span>
		</div>
		<div class="h-2 w-full rounded-full bg-muted overflow-hidden" role="progressbar">
			<div
				class="h-full rounded-full transition-all"
				style={ "width:" + ccBarWidth(usage) + ";" + ccBarColorStyle(usage) }
			></div>
		</div>
	</div>
}

func ccOverageClass(status string) string {
	switch status {
	case "allowed":
		return "bg-emerald-100 text-emerald-700"
	case "rejected":
		return "bg-destructive/10 text-destructive"
	case "allowed_warning":
		return "bg-amber-100 text-amber-700"
	default:
		return "bg-muted text-muted-foreground"
	}
}

func ccOverageBadgeClass(reason string) string {
	switch reason {
	case "allowed":
		return "bg-emerald-100 text-emerald-700"
	case "rejected":
		return "bg-red-100 text-red-700"
	case "":
		return "bg-gray-100 text-gray-500"
	default:
		return "bg-amber-100 text-amber-700"
	}
}

func ccOverageBadgeLabel(reason string) string {
	if reason == "" {
		return "unknown"
	}
	return reason
}

func ccCompositeScoreStyle(v *float64) string {
	if v == nil {
		return ""
	}
	switch {
	case *v < 1.0:
		return "color:#22c55e" // green  — plenty of capacity relative to time
	case *v < 3.0:
		return "color:#f97316" // orange — moderate capacity constraint
	default:
		return "color:#ef4444" // red    — nearing gate with significant time remaining
	}
}

func ccTimeAgo(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	default:
		return t.Format("Jan 2, 15:04")
	}
}
