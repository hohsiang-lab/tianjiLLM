package pages

import (
	"fmt"
	"strconv"

	"github.com/praxisllmlab/tianjiLLM/internal/ui/components/badge"
	"github.com/praxisllmlab/tianjiLLM/internal/ui/components/button"
	"github.com/praxisllmlab/tianjiLLM/internal/ui/components/card"
	"github.com/praxisllmlab/tianjiLLM/internal/ui/components/dialog"
	"github.com/praxisllmlab/tianjiLLM/internal/ui/components/table"
	"github.com/praxisllmlab/tianjiLLM/internal/ui/components/toast"
)

type CredentialsPageData struct {
	Rows                  []CredentialRow
	TotalCount            int
	ConnectURL            string
	ConnectDisabledReason string
	DeviceCSRFToken       string
}

type CredentialRow struct {
	ID                 string
	Name               string
	Email              string
	OrganizationID     string
	CredentialStatus   string
	CredentialVariant  string
	QuotaStatus        string
	QuotaStatusVariant string
	QuotaSummary       string
	LastRefresh        string
	LastError          string
	CreatedAt          string
	UpdatedAt          string
	LifecycleAction       string
	LifecycleActionLabel  string
	LifecycleActionPrompt string
}

type CredentialDetailData struct {
	ID                 string
	Name               string
	Email              string
	OrganizationID     string
	CredentialStatus   string
	CredentialVariant  string
	QuotaStatus        string
	QuotaStatusVariant string
	QuotaSummary       string
	LastRefresh        string
	LastError          string
	DisabledReason     string
	CreatedAt          string
	UpdatedAt          string
	HasQuota           bool
	QuotaUpdatedAt     string
	QuotaReset         string
	Dimensions         []QuotaDimensionView
	CodexUsage         CodexUsageCredentialCard
	LifecycleAction       string
	LifecycleActionLabel  string
	LifecycleActionPrompt string
}

type QuotaDimensionView struct {
	Name               string
	Limit              string
	Remaining          string
	Reset              string
	Utilization        string
	UtilizationPercent float64
	UtilizationKnown   bool
}

func FormatCount(value int) string {
	raw := strconv.Itoa(value)
	if value < 0 {
		raw = raw[1:]
	}
	n := len(raw)
	if n <= 3 {
		if value < 0 {
			return "-" + raw
		}
		return raw
	}
	out := make([]byte, 0, n+(n-1)/3)
	first := n % 3
	if first == 0 {
		first = 3
	}
	out = append(out, raw[:first]...)
	for i := first; i < n; i += 3 {
		out = append(out, ',')
		out = append(out, raw[i:i+3]...)
	}
	if value < 0 {
		return "-" + string(out)
	}
	return string(out)
}

func FormatPercent(value float64) string {
	return fmt.Sprintf("%.1f%%", value*100)
}

func badgeVariant(name string) badge.Variant {
	switch name {
	case "destructive":
		return badge.VariantDestructive
	case "outline":
		return badge.VariantOutline
	case "secondary":
		return badge.VariantSecondary
	default:
		return badge.VariantDefault
	}
}

templ CredentialsPage(data CredentialsPageData) {
	@AppLayout("Credentials", "/ui/credentials") {
		@dialog.Script()
		<div class="space-y-4">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				@toast.Script()
				<div>
					<h2 class="text-lg font-semibold">OpenAI subscription credentials</h2>
					<p class="text-sm text-muted-foreground">
						{ fmt.Sprintf("%d credential(s)", data.TotalCount) }
					</p>
				</div>
				<div class="flex flex-wrap items-center justify-start gap-2 sm:justify-end">
					if data.ConnectURL != "" {
						@openAIDeviceAuthDialog(data.DeviceCSRFToken)
						@openAIPasteCallbackDialog(data.DeviceCSRFToken)
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Href:       data.ConnectURL,
							Target:     "_blank",
							Attributes: templ.Attributes{"rel": "noopener"},
						}) {
							Browser callback fallback
						}
					} else {
						@button.Button(button.Props{Disabled: true, Attributes: templ.Attributes{"title": data.ConnectDisabledReason}}) {
							Connect OpenAI
						}
					}
				</div>
			</div>
			@card.Card() {
				@card.Content(card.ContentProps{Class: "p-0"}) {
					@CredentialsTable(data)
				}
			}
		</div>
	}
}

templ openAIPasteCallbackDialog(csrfToken string) {
	@dialog.Dialog(dialog.Props{ID: "openai-callback-url-dialog"}) {
		@dialog.Trigger(dialog.TriggerProps{}) {
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				Paste callback URL
			}
		}
		@dialog.Content(dialog.ContentProps{Class: "max-w-lg"}) {
			@dialog.Header() {
				@dialog.Title() {
					Paste callback URL
				}
				@dialog.Description() {
					Paste the full localhost URL from the OpenAI authorization tab.
				}
			}
			<form method="post" action="/ui/openai/callback-url" hx-post="/ui/openai/callback-url" hx-target="body">
				<input type="hidden" name="csrf_token" value={ csrfToken } />
				<div class="space-y-2 py-4">
					<label for="callback_url" class="text-sm font-medium">Callback URL</label>
					<textarea
						id="callback_url"
						name="callback_url"
						rows="4"
						required
						class="flex min-h-24 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]"
						placeholder="http://localhost:1455/auth/callback?..."
					></textarea>
				</div>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							Cancel
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Connect credential
					}
				}
			</form>
		}
	}
}

templ CredentialsTable(data CredentialsPageData) {
	<div id="credentials-table" class="overflow-x-auto">
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() { Name }
					@table.Head() { Email }
					@table.Head() { Credential status }
					@table.Head() { Quota }
					@table.Head() { Organization }
					@table.Head() { Last refresh }
					@table.Head() { Last error }
					@table.Head() { Actions }
				}
			}
			@table.Body() {
				if len(data.Rows) == 0 {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "py-10 text-center text-muted-foreground", Attributes: templ.Attributes{"colspan": "8"}}) {
							No OpenAI subscription credentials found
						}
					}
				} else {
					for _, row := range data.Rows {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "font-medium min-w-48"}) {
								<a class="text-primary underline-offset-4 hover:underline" href={ templ.SafeURL("/ui/credentials/" + row.ID) }>
									{ row.Name }
								</a>
								<div class="font-mono text-xs text-muted-foreground">{ row.ID }</div>
							}
							@table.Cell(table.CellProps{Class: "min-w-56"}) {
								{ row.Email }
							}
							@table.Cell() {
								@badge.Badge(badge.Props{Variant: badgeVariant(row.CredentialVariant)}) {
									{ row.CredentialStatus }
								}
							}
							@table.Cell(table.CellProps{Class: "min-w-44"}) {
								<div class="space-y-1">
									@badge.Badge(badge.Props{Variant: badgeVariant(row.QuotaStatusVariant)}) {
										{ row.QuotaStatus }
									}
									<div class="text-xs text-muted-foreground">{ row.QuotaSummary }</div>
								</div>
							}
							@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
								{ row.OrganizationID }
							}
							@table.Cell(table.CellProps{Class: "min-w-40 text-xs text-muted-foreground"}) {
								{ row.LastRefresh }
							}
							@table.Cell(table.CellProps{Class: "max-w-72 text-xs text-muted-foreground whitespace-normal break-words"}) {
								{ row.LastError }
							}
							@table.Cell(table.CellProps{Class: "min-w-72"}) {
								@CredentialActions(row.ID, "credentials-table", row.LifecycleAction, row.LifecycleActionLabel, row.LifecycleActionPrompt)
							}
						}
					}
				}
			}
		}
	</div>
}

templ CredentialDetailPage(data CredentialDetailData) {
	@AppLayout(data.Name+" — Credential Detail", "/ui/credentials") {
		@toast.Script()
		@CredentialDetailContent(data)
	}
}

templ CredentialDetailContent(data CredentialDetailData) {
	<div id="credential-detail-content" class="space-y-6">
			<div class="flex items-start justify-between gap-4">
				<div class="space-y-2 min-w-0">
					<div class="flex flex-wrap items-center gap-2">
						<h2 class="text-lg font-semibold break-words">{ data.Name }</h2>
						@badge.Badge(badge.Props{Variant: badgeVariant(data.CredentialVariant)}) {
							{ data.CredentialStatus }
						}
						@badge.Badge(badge.Props{Variant: badgeVariant(data.QuotaStatusVariant)}) {
							{ data.QuotaStatus }
						}
					</div>
					<div class="font-mono text-xs text-muted-foreground break-all">{ data.ID }</div>
				</div>
				<a href="/ui/credentials">
					@button.Button(button.Props{Variant: button.VariantGhost}) {
						← Back to Credentials
					}
				</a>
			</div>
			@CredentialActions(data.ID, "credential-detail-content", data.LifecycleAction, data.LifecycleActionLabel, data.LifecycleActionPrompt)

			<div class="grid gap-4 md:grid-cols-3">
				@summaryCard("Account", data.Email, "Organization: "+data.OrganizationID)
				@summaryCard("Credential health", data.CredentialStatus, "Last refresh: "+data.LastRefresh)
				@summaryCard("Quota gate", data.QuotaSummary, "Reset: "+data.QuotaReset)
			</div>

			@card.Card() {
				@card.Header() {
					@card.Title() {
						Quota dimensions
					}
					@card.Description() {
						if data.HasQuota {
							Updated { data.QuotaUpdatedAt }
						} else {
							No upstream quota data recorded yet
						}
					}
				}
				@card.Content(card.ContentProps{Class: "p-0 pt-4"}) {
					<div class="overflow-x-auto">
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() { Dimension }
									@table.Head() { Limit }
									@table.Head() { Remaining }
									@table.Head() { Utilization }
									@table.Head() { Reset }
								}
							}
							@table.Body() {
								for _, row := range data.Dimensions {
									@table.Row() {
										@table.Cell(table.CellProps{Class: "font-medium"}) {
											{ row.Name }
										}
										@table.Cell() {
											{ row.Limit }
										}
										@table.Cell() {
											{ row.Remaining }
										}
										@table.Cell(table.CellProps{Class: "min-w-52"}) {
											<div class="space-y-1">
												<div class="text-sm">{ row.Utilization }</div>
												<div class="h-2 w-full min-w-36 rounded-full bg-muted">
													if row.UtilizationKnown {
														<div class="h-2 rounded-full bg-primary" style={ fmt.Sprintf("width: %.1f%%", row.UtilizationPercent) }></div>
													}
												</div>
											</div>
										}
										@table.Cell(table.CellProps{Class: "min-w-40 text-xs text-muted-foreground"}) {
											{ row.Reset }
										}
									}
								}
							}
						}
					</div>
				}
			}

			@CredentialCodexUsage(data.CodexUsage)

			<div class="grid gap-4 md:grid-cols-2">
				@metadataCard("Last error", data.LastError)
				@metadataCard("Disabled reason", data.DisabledReason)
			</div>
	</div>
}

templ CredentialCodexUsage(cardData CodexUsageCredentialCard) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Codex usage
			}
			@card.Description() {
				Best-effort snapshot from the OpenAI subscription credential
			}
		}
		@card.Content(card.ContentProps{Class: "pt-4"}) {
			@codexUsageCardBody(cardData, true)
		}
	}
}

templ CredentialActions(credentialID, targetID, lifecycleAction, lifecycleLabel, lifecycleConfirm string) {
	<div class="flex flex-wrap items-center gap-2">
		@credentialActionForm(credentialID, "test", "Test", targetID, "")
		@credentialActionForm(credentialID, "refresh", "Refresh", targetID, "")
		@credentialActionForm(credentialID, fallbackLifecycleAction(lifecycleAction), fallbackLifecycleLabel(lifecycleLabel), targetID, lifecycleConfirm)
		@credentialActionForm(credentialID, "delete", "Delete", targetID, "Delete this OpenAI subscription credential? This action cannot be undone.")
	</div>
}

templ credentialActionForm(credentialID, action, label, targetID, confirm string) {
	<form
		hx-post={ "/ui/credentials/" + credentialID + "/" + action }
		hx-target={ "#" + targetID }
		hx-swap="outerHTML"
		{ credentialActionConfirmAttributes(confirm)... }
	>
		@button.Button(button.Props{
			Type: "submit",
			Size: button.SizeSm,
			Variant: actionButtonVariant(action),
		}) {
			{ label }
		}
	</form>
}

func actionButtonVariant(action string) button.Variant {
	if action == "delete" {
		return button.VariantDestructive
	}
	if action == "disable" {
		return button.VariantOutline
	}
	return button.VariantSecondary
}

func fallbackLifecycleAction(action string) string {
	if action == "enable" {
		return "enable"
	}
	return "disable"
}

func fallbackLifecycleLabel(label string) string {
	if label != "" {
		return label
	}
	return "Disable"
}

func credentialActionConfirmAttributes(confirm string) templ.Attributes {
	if confirm == "" {
		return templ.Attributes{}
	}
	return templ.Attributes{"hx-confirm": confirm}
}

templ CredentialsTableWithToast(data CredentialsPageData, toastMsg string, toastVariant toast.Variant) {
	@CredentialsTable(data)
	if toastMsg != "" {
		<div id="toast-oob" hx-swap-oob="afterbegin:body">
			@toast.Toast(toast.Props{
				Title:         toastMsg,
				Variant:       toastVariant,
				Duration:      5000,
				ShowIndicator: true,
			})
		</div>
	}
}

templ CredentialDetailContentWithToast(data CredentialDetailData, toastMsg string, toastVariant toast.Variant) {
	@CredentialDetailContent(data)
	if toastMsg != "" {
		<div id="toast-oob" hx-swap-oob="afterbegin:body">
			@toast.Toast(toast.Props{
				Title:         toastMsg,
				Variant:       toastVariant,
				Duration:      5000,
				ShowIndicator: true,
			})
		</div>
	}
}

templ summaryCard(label, value, detail string) {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-sm"}) {
				{ label }
			}
		}
		@card.Content() {
			<div class="space-y-1">
				<div class="text-xl font-semibold break-words">{ value }</div>
				<div class="text-xs text-muted-foreground break-words">{ detail }</div>
			</div>
		}
	}
}

templ metadataCard(label, value string) {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-sm"}) {
				{ label }
			}
		}
		@card.Content() {
			<p class="text-sm text-muted-foreground whitespace-pre-wrap break-words">{ value }</p>
		}
	}
}
